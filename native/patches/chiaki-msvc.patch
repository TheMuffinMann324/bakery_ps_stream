index 4c4843d..eaf84f8 100644
--- a/lib/include/chiaki/common.h
+++ b/lib/include/chiaki/common.h
@@ -17,6 +17,15 @@
 extern "C" {
 #endif
 
+// Stack array with a runtime size. MSVC has no C99 VLAs, so use _alloca there.
+// Note: unlike a VLA, sizeof(name) is the pointer size, not the array size.
+#ifdef _MSC_VER
+#include <malloc.h>
+#define CHIAKI_VLA(type, name, count) type *name = (type *)_alloca(sizeof(type) * (size_t)(count))
+#else
+#define CHIAKI_VLA(type, name, count) type name[count]
+#endif
+
 #ifdef __GNUC__
 typedef uint32_t chiaki_unaligned_uint32_t __attribute__((aligned(1)));
 typedef uint16_t chiaki_unaligned_uint16_t __attribute__((aligned(1)));
